pipeline {
    agent any

    stages {
        stage('Build Image') {
            steps {
                sh 'docker build -t osama8558/devops-auto-app:v1 .'
            }
        }

        stage('Push To Docker Hub') {
            steps {
                sh 'docker push osama8558/devops-auto-app:v1'
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker rm -f osama-auto-container || true'
                sh 'docker run -d -p 9091:80 --name osama-auto-container osama8558/devops-auto-app:v1'
            }
        }
    }
}
